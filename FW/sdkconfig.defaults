CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Release / size-optimized firmware (lower CPU wake cost than -Og debug)
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
# CONFIG_COMPILER_OPTIMIZATION_DEBUG is not set

# Power: light sleep when idle (always-on battery device)
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_HZ=100
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_80=y

CONFIG_LOG_DEFAULT_LEVEL_WARN=y

# OASIS uses BLE only — no WiFi stack (LWIP stays on for TLS/crypto deps)
# CONFIG_ESP_WIFI_ENABLED is not set

# NimBLE peripheral: advertise + accept one connection
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
# CONFIG_BT_NIMBLE_ROLE_CENTRAL is not set
# CONFIG_BT_NIMBLE_ROLE_OBSERVER is not set
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_INTERNAL=y

CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=517
CONFIG_BT_NIMBLE_GATT_MAX_PROCS=8

# Only GAP — custom Nordic UART GATT is registered in ble_uart.c
# CONFIG_BT_NIMBLE_DIS_SERVICE is not set
# CONFIG_BT_NIMBLE_BAS_SERVICE is not set
# CONFIG_BT_NIMBLE_PROX_SERVICE is not set
# CONFIG_BT_NIMBLE_ANS_SERVICE is not set
# CONFIG_BT_NIMBLE_CTS_SERVICE is not set
# CONFIG_BT_NIMBLE_HTP_SERVICE is not set
# CONFIG_BT_NIMBLE_IPSS_SERVICE is not set
# CONFIG_BT_NIMBLE_TPS_SERVICE is not set
# CONFIG_BT_NIMBLE_IAS_SERVICE is not set
# CONFIG_BT_NIMBLE_LLS_SERVICE is not set
# CONFIG_BT_NIMBLE_SPS_SERVICE is not set
# CONFIG_BT_NIMBLE_HR_SERVICE is not set
# CONFIG_BT_NIMBLE_HID_SERVICE is not set

# NimBLE logging — WARN only
# CONFIG_BT_NIMBLE_LOG_LEVEL_INFO is not set
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y

# Peripheral-only: no scanning / BLE 5 observer features
# CONFIG_BT_NIMBLE_50_FEATURE_SUPPORT is not set
# CONFIG_BT_NIMBLE_EXT_SCAN is not set
# CONFIG_BT_NIMBLE_ENABLE_PERIODIC_SYNC is not set

CONFIG_BT_CTRL_MODEM_SLEEP=y
CONFIG_BT_CTRL_MODEM_SLEEP_MODE_1=y

# Desk range — lower BLE TX than default +9 dBm (saves radio power)
# CONFIG_BT_CTRL_DFT_TX_POWER_LEVEL_P9 is not set
CONFIG_BT_CTRL_DFT_TX_POWER_LEVEL_P3=y

# USB-serial console + battery charge detect (usb_serial_jtag_is_connected)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG_ENABLED=y
